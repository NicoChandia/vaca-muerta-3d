{
  "framework": "angular",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/app/browser",
  "rewrites": [
    {
      "source": "/(que-es|produccion|subsuelo|rendimiento)",
      "destination": "/$1/index.html"
    },
    {
      "source": "/en/(what-is|production|underground|performance)",
      "destination": "/en/$1/index.html"
    },
    {
      "source": "/((?!data/|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
